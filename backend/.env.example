# Configuration MongoDB
URL_MONGODB=mongodb://localhost:27017
NOM_BASE_DONNEES=admission_intelligente

# Configuration FastAPI
ENVIRONNEMENT_FASTAPI=developpement
PORT_API=8000
HOTE_API=0.0.0.0

# Chemin des Modèles ML
CHEMIN_MODELES=./app/modeles_entraines/

# Journalisation
NIVEAU_JOURNAL=INFO

# Authentification administrateur (obligatoire pour activer la connexion admin)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-please

# Clé de signature des JWT - générer une vraie valeur aléatoire en production,
# par exemple avec: python -c "import secrets; print(secrets.token_hex(32))"
# Si absente, une clé temporaire est générée au démarrage (tokens invalidés à chaque redémarrage).
JWT_SECRET_KEY=

# Origines CORS supplémentaires autorisées en production (séparées par des virgules)
# Exemple: https://mon-app.exemple.com,https://admin.mon-app.exemple.com
CORS_ORIGINES_SUPPLEMENTAIRES=
